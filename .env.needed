# FLASK
SECRET_KEY="-"
# The public URL of the site, used to build the links in emails.
# Session cookies are https-only when this starts with https://
SET_HOST_URL="http://127.0.0.1:5001"

# RUN_ENV [development, production]
RUN_ENV="development"

# EMAIL (https://notifyvia.email)
NOTIFYVIA_EMAIL_API_KEY="your-api-key"
# Set to 1 to print emails to the console instead of sending them
EMAIL_DEV_MODE="0"
